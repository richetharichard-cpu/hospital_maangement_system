CREATE DATABASE IF NOT EXISTS HospitalDB;
USE HospitalDB;

-- ─────────────────────────────────────────
-- 1. DEPARTMENTS
-- ─────────────────────────────────────────
CREATE TABLE IF NOT EXISTS Department (
    dept_id       INT AUTO_INCREMENT PRIMARY KEY,
    dept_name     VARCHAR(100) NOT NULL,
    location      VARCHAR(100),
    head_doctor   VARCHAR(100)
);

-- ─────────────────────────────────────────
-- 2. DOCTORS
-- ─────────────────────────────────────────
CREATE TABLE IF NOT EXISTS Doctor (
    doctor_id     INT AUTO_INCREMENT PRIMARY KEY,
    name          VARCHAR(100) NOT NULL,
    specialization VARCHAR(100),
    phone         VARCHAR(15),
    email         VARCHAR(100),
    dept_id       INT,
    available_days VARCHAR(100) DEFAULT 'Mon-Fri',
    FOREIGN KEY (dept_id) REFERENCES Department(dept_id) ON DELETE SET NULL
);

-- ─────────────────────────────────────────
-- 3. PATIENTS
-- ─────────────────────────────────────────
CREATE TABLE IF NOT EXISTS Patient (
    patient_id    INT AUTO_INCREMENT PRIMARY KEY,
    name          VARCHAR(100) NOT NULL,
    dob           DATE,
    gender        ENUM('Male','Female','Other'),
    phone         VARCHAR(15),
    email         VARCHAR(100),
    address       TEXT,
    blood_group   VARCHAR(5),
    registered_on DATETIME DEFAULT CURRENT_TIMESTAMP
);

-- ─────────────────────────────────────────
-- 4. ROOMS
-- ─────────────────────────────────────────
CREATE TABLE IF NOT EXISTS Room (
    room_id       INT AUTO_INCREMENT PRIMARY KEY,
    room_number   VARCHAR(10) NOT NULL UNIQUE,
    room_type     ENUM('General','ICU','Private','Emergency'),
    status        ENUM('Available','Occupied','Maintenance') DEFAULT 'Available',
    charges_per_day DECIMAL(10,2) DEFAULT 500.00
);

-- ─────────────────────────────────────────
-- 5. ADMISSIONS
-- ─────────────────────────────────────────
CREATE TABLE IF NOT EXISTS Admission (
    admission_id  INT AUTO_INCREMENT PRIMARY KEY,
    patient_id    INT NOT NULL,
    room_id       INT,
    doctor_id     INT,
    admit_date    DATETIME DEFAULT CURRENT_TIMESTAMP,
    discharge_date DATETIME,
    diagnosis     TEXT,
    status        ENUM('Admitted','Discharged') DEFAULT 'Admitted',
    FOREIGN KEY (patient_id) REFERENCES Patient(patient_id) ON DELETE CASCADE,
    FOREIGN KEY (room_id)    REFERENCES Room(room_id) ON DELETE SET NULL,
    FOREIGN KEY (doctor_id)  REFERENCES Doctor(doctor_id) ON DELETE SET NULL
);

-- ─────────────────────────────────────────
-- 6. APPOINTMENTS
-- ─────────────────────────────────────────
CREATE TABLE IF NOT EXISTS Appointment (
    appt_id       INT AUTO_INCREMENT PRIMARY KEY,
    patient_id    INT NOT NULL,
    doctor_id     INT NOT NULL,
    appt_date     DATE NOT NULL,
    appt_time     TIME NOT NULL,
    reason        TEXT,
    status        ENUM('Scheduled','Completed','Cancelled') DEFAULT 'Scheduled',
    FOREIGN KEY (patient_id) REFERENCES Patient(patient_id) ON DELETE CASCADE,
    FOREIGN KEY (doctor_id)  REFERENCES Doctor(doctor_id) ON DELETE CASCADE
);

-- ─────────────────────────────────────────
-- 7. MEDICINES
-- ─────────────────────────────────────────
CREATE TABLE IF NOT EXISTS Medicine (
    med_id        INT AUTO_INCREMENT PRIMARY KEY,
    med_name      VARCHAR(100) NOT NULL,
    category      VARCHAR(100),
    price         DECIMAL(10,2),
    stock_qty     INT DEFAULT 0
);

-- ─────────────────────────────────────────
-- 8. PRESCRIPTIONS
-- ─────────────────────────────────────────
CREATE TABLE IF NOT EXISTS Prescription (
    pres_id       INT AUTO_INCREMENT PRIMARY KEY,
    patient_id    INT NOT NULL,
    doctor_id     INT NOT NULL,
    med_id        INT NOT NULL,
    dosage        VARCHAR(100),
    days          INT,
    prescribed_on DATETIME DEFAULT CURRENT_TIMESTAMP,
    FOREIGN KEY (patient_id) REFERENCES Patient(patient_id) ON DELETE CASCADE,
    FOREIGN KEY (doctor_id)  REFERENCES Doctor(doctor_id) ON DELETE CASCADE,
    FOREIGN KEY (med_id)     REFERENCES Medicine(med_id) ON DELETE CASCADE
);

-- ─────────────────────────────────────────
-- 9. BILLING
-- ─────────────────────────────────────────
CREATE TABLE IF NOT EXISTS Bill (
    bill_id       INT AUTO_INCREMENT PRIMARY KEY,
    patient_id    INT NOT NULL,
    admission_id  INT,
    room_charges  DECIMAL(10,2) DEFAULT 0,
    medicine_charges DECIMAL(10,2) DEFAULT 0,
    doctor_charges DECIMAL(10,2) DEFAULT 0,
    other_charges  DECIMAL(10,2) DEFAULT 0,
    total_amount   DECIMAL(10,2) GENERATED ALWAYS AS
                   (room_charges + medicine_charges + doctor_charges + other_charges) STORED,
    payment_status ENUM('Pending','Paid','Partial') DEFAULT 'Pending',
    bill_date      DATETIME DEFAULT CURRENT_TIMESTAMP,
    FOREIGN KEY (patient_id)   REFERENCES Patient(patient_id) ON DELETE CASCADE,
    FOREIGN KEY (admission_id) REFERENCES Admission(admission_id) ON DELETE SET NULL
);

-- ─────────────────────────────────────────
-- 10. STAFF
-- ─────────────────────────────────────────
CREATE TABLE IF NOT EXISTS Staff (
    staff_id      INT AUTO_INCREMENT PRIMARY KEY,
    name          VARCHAR(100) NOT NULL,
    role          ENUM('Nurse','Lab Technician','Receptionist','Admin','Pharmacist'),
    dept_id       INT,
    phone         VARCHAR(15),
    salary        DECIMAL(10,2),
    FOREIGN KEY (dept_id) REFERENCES Department(dept_id) ON DELETE SET NULL
);

