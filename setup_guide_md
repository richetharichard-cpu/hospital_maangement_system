## 📌 Quick SQL Queries to Try

```sql
-- All admitted patients
SELECT p.name, d.name AS doctor, r.room_number
FROM Admission a
JOIN Patient p ON a.patient_id = p.patient_id
JOIN Doctor  d ON a.doctor_id  = d.doctor_id
JOIN Room    r ON a.room_id    = r.room_id
WHERE a.status = 'Admitted';

-- Total revenue from bills
SELECT SUM(total_amount) AS Total_Revenue FROM Bill;

-- Available rooms
SELECT room_number, room_type, charges_per_day
FROM Room WHERE status = 'Available';

-- Upcoming appointments
SELECT p.name, d.name AS doctor, appt_date, appt_time
FROM Appointment a
JOIN Patient p ON a.patient_id = p.patient_id
JOIN Doctor  d ON a.doctor_id  = d.doctor_id
WHERE a.status = 'Scheduled'
ORDER BY appt_date, appt_time;
```
